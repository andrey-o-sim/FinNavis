{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet clean:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet test:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(dotnet publish:*)",
      "Bash(rm -rf:*)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/Properties/launchSettings.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pem)",
      "Write(**/*.pfx)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*credential*)",
      "Write(**/*secret*)"
    ]
  },
  "enabledPlugins": {
    "my-toolkit@andsim-claude-code-toolkit": true
  }
}