# Build output
bin/
obj/
artifacts/
TestResults/
*.user
*.suo

# IDE
.vs/
.idea/
.vscode/
*.swp

# Local run settings. Copy launchSettings.example.json instead.
launchSettings.json
appsettings.Local.json
appsettings.*.Local.json

# Secrets and environment files. Never commit these.
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Node / frontend
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# OS
.DS_Store
Thumbs.db

# Crash dumps from Git Bash. The MSYS2 runtime writes <exe>.stackdump into the
# working directory when a shell process dies, so they land in the repo root.
*.stackdump
